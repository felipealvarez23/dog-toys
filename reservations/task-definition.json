{
  "family": "reservation-task",
  "executionRoleArn": "${AWS_ECS_EXECUTION_ROLE_ARN}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${AWS_ECS_TASK_CPU}",
  "memory": "${AWS_ECS_TASK_MEMORY}",
  "containerDefinitions": [
    {
      "name": "${CONTAINER_NAME}",
      "image": "${AWS_ECR_IMAGE_URL}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "dev"
        },
        {
          "name": "DB_HOST",
          "value": "${AWS_RDS_DB_HOST}"
        },
        {
          "name": "DB_PORT",
          "value": "${AWS_RDS_DB_PORT}"
        },
        {
          "name": "DB_NAME",
          "value": "${AWS_RDS_DB_NAME}"
        },
        {
          "name": "DB_SCHEMA",
          "value": "${AWS_RDS_DB_SCHEMA}"
        }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "${AWS_SECRETMAN_RDS_ARN}:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${AWS_SECRETMAN_RDS_ARN}:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/reservation",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}