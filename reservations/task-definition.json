{
  "family": "reservation-task",
  "executionRoleArn": "<EXECUTION_ROLE_ARN>",
  "taskRoleArn":"arn:aws:iam::443414059882:role/ecsTaskRole-reservation",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "reservation-app",
      "image": "<IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "dev"
        },
        {
          "name": "DB_HOST",
          "value": "reservation-db.cluster-csbaqeso6ytp.us-east-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "postgres"
        }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:443414059882:secret:rds!cluster-4f6acfe2-d305-4ad5-9dc3-3b64aaaec0d0-xyJNF7"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:443414059882:secret:rds!cluster-4f6acfe2-d305-4ad5-9dc3-3b64aaaec0d0-xyJNF7"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/reservation",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}